# EvidenceFlow AI - Environment Variable Template
# Copy this file to .env and insert your real credentials:
# PowerShell: Copy-Item .env.example .env

# --- Embedding Configuration ---
# Options: 'fastembed' (local ONNX, 384-dim, no API key needed) or 'gemini' (768-dim, requires GEMINI_API_KEY)
EMBEDDING_PROVIDER=fastembed

# --- Gemini API Configuration ---
# Your Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- PostgreSQL Configuration (Checkpointer, Step Ledger & Audit Trail) ---
POSTGRES_USER=evidenceflow
POSTGRES_PASSWORD=evidenceflow_dev_secret
POSTGRES_DB=evidenceflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is automatically computed by config.py from the above parts.
# You can uncomment and override it if using an external managed PostgreSQL instance:
# DATABASE_URL=postgresql+psycopg://evidenceflow:evidenceflow_dev_secret@localhost:5432/evidenceflow_db

# --- Qdrant Vector Store Configuration (Dense + Sparse Hybrid Retrieval) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=evidenceflow_passages

# --- Neo4j Graph Database Configuration (Conversational Memory & Contradiction Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# IMPORTANT: Neo4j 5.x requires passwords of at least 8 characters
NEO4J_PASSWORD=evidenceflow_graph_secret

# --- Application Runtime Settings ---
APP_ENV=development
LOG_LEVEL=INFO
